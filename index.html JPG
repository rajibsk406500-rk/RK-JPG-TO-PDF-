<script>
pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
setupRkPdfPasswordDialog();
const $=id=>document.getElementById(id);let images=[];
(function(){
 const saved=localStorage.getItem('rk-theme')||'light';
 const applyTheme=t=>{document.body.classList.toggle('dark-mode',t==='dark');const b=$('themeToggle');if(b){b.innerHTML=t==='dark'?'<i class="fa-solid fa-sun"></i><span id="themeLabel">Light</span>':'<i class="fa-solid fa-moon"></i><span id="themeLabel">Dark</span>';b.setAttribute('aria-label',t==='dark'?'Switch to light mode':'Switch to dark mode')}};
 applyTheme(saved);$('themeToggle').onclick=()=>{const next=document.body.classList.contains('dark-mode')?'light':'dark';localStorage.setItem('rk-theme',next);applyTheme(next)};
})();
function switchTab(name){$('jpgToPdf').classList.toggle('active',name==='jpg');$('pdfToJpg').classList.toggle('active',name==='pdf');$('tabJpgToPdf').classList.toggle('active',name==='jpg');$('tabPdfToJpg').classList.toggle('active',name==='pdf')}
$('tabJpgToPdf').onclick=()=>switchTab('jpg');$('tabPdfToJpg').onclick=()=>switchTab('pdf');$('jpgBox').onclick=()=>$('jpgInput').click();$('pdfBox').onclick=()=>$('pdfInput').click();
function readFile(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file)})}
$('jpgInput').onchange=async e=>{const fs=[...e.target.files];if(!fs.length)return;$('jpgBox').classList.add('uploaded');$('jpgText').textContent=`Total ${fs.length} Images Selected`;for(const f of fs)images.push({dataUrl:await readFile(f),rotation:0});renderImages()};
function renderImages(){const g=$('imageGrid');g.innerHTML='';$('jpgText').textContent=`Total ${images.length} Images Selected`;images.forEach((x,i)=>{const c=document.createElement('div');c.className='img-card';c.dataset.page=i+1;c.innerHTML=`<img src="${x.dataUrl}" style="transform:rotate(${x.rotation}deg)"><div class="actions"><button ${i?'':'disabled'} onclick="moveImage(${i},-1)">◀</button><button onclick="rotateImage(${i})">↻</button><button ${i===images.length-1?'disabled':''} onclick="moveImage(${i},1)">▶</button><button class="remove" onclick="removeImage(${i})"><i class="fa-solid fa-xmark"></i></button></div>`;g.appendChild(c)})}
function moveImage(i,d){const j=i+d;if(j<0||j>=images.length)return;[images[i],images[j]]=[images[j],images[i]];renderImages()}function rotateImage(i){images[i].rotation=(images[i].rotation+90)%360;renderImages()}function removeImage(i){images.splice(i,1);renderImages()}
function rotatedPng(data,deg){return new Promise((res,rej)=>{const img=new Image();img.onload=()=>{const c=document.createElement('canvas');c.width=(deg%180?img.height:img.width);c.height=(deg%180?img.width:img.height);const x=c.getContext('2d');x.translate(c.width/2,c.height/2);x.rotate(deg*Math.PI/180);x.drawImage(img,-img.width/2,-img.height/2);c.toBlob(b=>b?b.arrayBuffer().then(res):rej(new Error('Image conversion failed')),'image/png')};img.onerror=rej;img.src=data})}
function setProgress(prefix,pct,msg){$(prefix+'Progress').style.display='block';$(prefix+'Bar').style.width=pct+'%';$(prefix+'Status').textContent=msg+' '+pct+'%'}function finishProgress(prefix){setProgress(prefix,100,prefix==='jpg'?'PDF creation complete!':'JPG creation complete!');setTimeout(()=>{$(prefix+'Progress').style.display='none';$(prefix+'Bar').style.width='0%'},800)}
async function imageToJpegBytes(data,deg,quality){return new Promise((res,rej)=>{const img=new Image();img.onload=()=>{const c=document.createElement('canvas');c.width=(deg%180?img.height:img.width);c.height=(deg%180?img.width:img.height);const x=c.getContext('2d',{alpha:false});x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.translate(c.width/2,c.height/2);x.rotate(deg*Math.PI/180);x.drawImage(img,-img.width/2,-img.height/2);c.toBlob(b=>b?b.arrayBuffer().then(res):rej(new Error('Image conversion failed')),'image/jpeg',quality)};img.onerror=rej;img.src=data})}
async function buildJpgPdf(targetKB){const target=Math.max(1,Number(targetKB))*1024;let best=null,bestSize=Infinity;const qualities=[.95,.85,.75,.65,.55,.45,.35,.28,.22,.18,.14,.1,.07,.05];for(const quality of qualities){const pdf=await PDFLib.PDFDocument.create();for(const item of images){const jpg=await imageToJpegBytes(item.dataUrl,item.rotation,quality);const im=await pdf.embedJpg(jpg);const pg=pdf.addPage([im.width,im.height]);pg.drawImage(im,{x:0,y:0,width:im.width,height:im.height})}const bytes=await pdf.save();if(bytes.length<=target && bytes.length<bestSize){best=bytes;bestSize=bytes.length}if(bytes.length<bestSize && !best)best=bytes;await new Promise(requestAnimationFrame)}if(!best){const pdf=await PDFLib.PDFDocument.create();for(const item of images){const jpg=await imageToJpegBytes(item.dataUrl,item.rotation,.05);const im=await pdf.embedJpg(jpg);const pg=pdf.addPage([im.width,im.height]);pg.drawImage(im,{x:0,y:0,width:im.width,height:im.height})}best=await pdf.save()}return best}
function sizePicker(id,value){return `<div class="size-picker"><label for="${id}"><i class="fa-solid fa-compress"></i> Target file size:</label><select id="${id}"><option value="100">100 KB</option><option value="150">150 KB</option><option value="200">200 KB</option><option value="250">250 KB</option><option value="300">300 KB</option></select><div class="size-note">Choose a target size, then download the optimized file.</div></div>`}
async function renderJpgPdfResult(targetKB){const name=($('pdfName').value.trim()||'RK_Doc').replace(/\.pdf$/i,'');const bytes=await buildJpgPdf(targetKB);const url=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));const old=$('jpgResult').dataset.url;if(old)URL.revokeObjectURL(old);$('jpgResult').dataset.url=url;$('jpgResult').innerHTML=`<div class="result"><p><i class="fa-solid fa-circle-check"></i> PDF Created Successfully!</p>${sizePicker('jpgSize',targetKB)}<a class="download" id="jpgDownload" href="${url}" download="${name}.pdf"><button class="btn"><i class="fa-solid fa-download"></i> Download ${name}.pdf</button></a></div>`;$('jpgSize').value=String(targetKB);$('jpgSize').onchange=async e=>{const sel=e.target,sz=Number(sel.value),btn=$('jpgDownload').querySelector('button');sel.disabled=true;btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Optimizing...';try{const b=await buildJpgPdf(sz);const nu=URL.createObjectURL(new Blob([b],{type:'application/pdf'}));const prev=$('jpgResult').dataset.url;if(prev)URL.revokeObjectURL(prev);$('jpgResult').dataset.url=nu;$('jpgDownload').href=nu}catch(err){alert('Size optimization error: '+err.message)}finally{sel.disabled=false;btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-download"></i> Download '+name+'.pdf'}}}
$('makePdf').onclick=async()=>{if(!images.length)return alert('Please select at least one image!');const btn=$('makePdf');btn.disabled=true;$('jpgResult').innerHTML='';try{setProgress('jpg',8,'Preparing images...');await renderJpgPdfResult(300);finishProgress('jpg')}catch(e){console.error(e);alert('PDF creation error: '+e.message);$('jpgProgress').style.display='none'}finally{btn.disabled=false}};
    // ===== Universal PDF Password Unlock System =====
    // Every PDF upload on the website goes through this loader. If the PDF is
    // locked, a professional in-page password box appears instead of allowing
    // downstream PDF/JPG code to fail with "No password given".
    const rkPdfCache = new WeakMap();
    let rkPdfPasswordResolver = null;
    let rkPdfPasswordRejecter = null;
    let rkPdfPasswordCurrentFile = '';

    function rkPdfLanguageText(key) {
        const lang = document.documentElement.lang === 'bn' ? 'bn' : 'en';
        const texts = {
            en: {
                title: 'PDF Password Required',
                message: 'This PDF is password protected. Enter the password to unlock and use the file.',
                placeholder: 'Enter PDF password',
                incorrect: 'Incorrect password. Please try again.',
                empty: 'Please enter the PDF password.',
                cancel: 'Cancel',
                unlock: '<i class="rk-pro-icon fa-solid fa-lock-open" aria-hidden="true"></i> Unlock PDF',
                unlocked: 'PDF unlocked successfully.'
            },
            bn: {
                title: 'PDF Password Required',
                message: 'This PDF is password protected. Enter the password to unlock and use the file.',
                placeholder: 'Enter PDF password',
                incorrect: 'Incorrect password. Please try again.',
                empty: 'Please enter the PDF password.',
                cancel: 'Cancel',
                unlock: '<i class="rk-pro-icon fa-solid fa-lock-open" aria-hidden="true"></i> Unlock PDF',
                unlocked: 'PDF unlocked successfully.'
            }
        };
        return texts[lang][key];
    }

    function rkPdfPasswordDialog(fileName, incorrect = false) {
        return new Promise((resolve, reject) => {
            const modal = document.getElementById('rkPdfPasswordModal');
            const input = document.getElementById('rkPdfPassInput');
            const error = document.getElementById('rkPdfPassError');
            const title = document.getElementById('rkPdfPassTitle');
            const message = document.getElementById('rkPdfPassMessage');
            const name = document.getElementById('rkPdfPassFileName');
            const cancel = document.getElementById('rkPdfPassCancel');
            const unlock = document.getElementById('rkPdfPassUnlock');
            if (!modal || !input || !error || !cancel || !unlock) {
                reject(new Error('PDF password dialog is unavailable.'));
                return;
            }
            rkPdfPasswordResolver = resolve;
            rkPdfPasswordRejecter = reject;
            rkPdfPasswordCurrentFile = fileName || 'Protected PDF';
            title.textContent = rkPdfLanguageText('title');
            message.textContent = rkPdfLanguageText('message');
            name.textContent = rkPdfPasswordCurrentFile;
            input.placeholder = rkPdfLanguageText('placeholder');
            cancel.textContent = rkPdfLanguageText('cancel');
            unlock.innerHTML = rkPdfLanguageText('unlock');
            error.textContent = incorrect ? rkPdfLanguageText('incorrect') : '';
            error.classList.toggle('show', !!incorrect);
            modal.classList.remove('rk-password-incorrect');
            if (incorrect) {
                // Reflow lets the coded SVG reaction animation replay on every wrong password attempt.
                void modal.offsetWidth;
                modal.classList.add('rk-password-incorrect');
            }
            input.value = '';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            setTimeout(() => input.focus(), 50);
        });
    }

    function finishRkPdfPasswordDialog(value, cancelled = false) {
        const modal = document.getElementById('rkPdfPasswordModal');
        if (modal) {
            modal.classList.remove('show');
            modal.classList.remove('rk-password-incorrect');
            modal.setAttribute('aria-hidden', 'true');
        }
        const resolver = rkPdfPasswordResolver;
        const rejecter = rkPdfPasswordRejecter;
        rkPdfPasswordResolver = null;
        rkPdfPasswordRejecter = null;
        if (cancelled) {
            if (rejecter) rejecter(new Error('PDF unlock cancelled.'));
        } else if (resolver) {
            resolver(value);
        }
    }

    function toggleRkPdfPassword() {
        const input = document.getElementById('rkPdfPassInput');
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
    }

    function setupRkPdfPasswordDialog() {
        const input = document.getElementById('rkPdfPassInput');
        const cancel = document.getElementById('rkPdfPassCancel');
        const unlock = document.getElementById('rkPdfPassUnlock');
        if (!input || !cancel || !unlock) return;
        const submit = () => {
            const value = input.value;
            if (!value) {
                const error = document.getElementById('rkPdfPassError');
                if (error) { error.textContent = rkPdfLanguageText('empty'); error.classList.add('show'); }
                input.focus();
                return;
            }
            finishRkPdfPasswordDialog(value, false);
        };
        unlock.onclick = submit;
        cancel.onclick = () => finishRkPdfPasswordDialog('', true);

        // As soon as the user starts typing again, reset the red angry face
        // back to the original single yellow smiling face with its happy animation.
        input.oninput = () => {
            const modal = document.getElementById('rkPdfPasswordModal');
            const error = document.getElementById('rkPdfPassError');
            if (modal) {
                const wasAngry = modal.classList.contains('rk-password-incorrect');
                modal.classList.remove('rk-password-incorrect');

                // Only the first keystroke after an error triggers the cheerful return.
                if (wasAngry) {
                    modal.classList.remove('rk-password-reset');
                    void modal.offsetWidth;
                    modal.classList.add('rk-password-reset');
                    setTimeout(() => modal.classList.remove('rk-password-reset'), 700);
                }
            }
            if (error) {
                error.classList.remove('show');
                error.textContent = '';
            }
        };

        input.onkeydown = (e) => { if (e.key === 'Enter') submit(); if (e.key === 'Escape') cancel.click(); };
    }

    async function openPdfWithPassword(data, fileName = 'Protected PDF') {
        // IMPORTANT: Use PDF.js's explicit `password` option and retry the load.
        // This is more reliable than an async passwordCallback on mobile browsers.
        // It prevents the original "No password given" error and lets the user
        // enter the password directly in the professional in-page dialog.
        let password = null;
        let isRetry = false;

        while (true) {
            try {
                const task = pdfjsLib.getDocument({ data, password });
                return await task.promise;
            } catch (err) {
                const isPasswordError = err && (
                    err.name === 'PasswordException' ||
                    err.code === pdfjsLib.PasswordResponses.NEED_PASSWORD ||
                    err.code === pdfjsLib.PasswordResponses.INCORRECT_PASSWORD
                );

                if (!isPasswordError) throw err;

                try {
                    password = await rkPdfPasswordDialog(fileName, isRetry);
                    isRetry = true;
                } catch (dialogErr) {
                    throw new Error('PDF unlock cancelled.');
                }
            }
        }
    }

    async function getPdfForFile(file) {
        if (rkPdfCache.has(file)) return rkPdfCache.get(file);
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await openPdfWithPassword(arrayBuffer, file.name);
        rkPdfCache.set(file, pdf);
        return pdf;
    }

$('pdfInput').onchange=e=>{const fs=[...e.target.files];if(!fs.length)return;$('pdfBox').classList.add('uploaded');$('pdfText').textContent=`Total ${fs.length} PDF(s) Selected`};
async function canvasToTargetJpeg(canvas,targetKB){const target=targetKB*1024;let work=canvas,scale=1;for(let resizePass=0;resizePass<5;resizePass++){let lo=.15,hi=.95,best=null;for(let i=0;i<9;i++){const q=(lo+hi)/2;const u=work.toDataURL('image/jpeg',q);const size=Math.floor((u.split(',')[1].length*3)/4);if(size<=target){best=u;lo=q}else hi=q}if(best)return best;if(resizePass<4){scale*=.8;const c=document.createElement('canvas');c.width=Math.max(1,Math.floor(canvas.width*scale));c.height=Math.max(1,Math.floor(canvas.height*scale));const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(canvas,0,0,c.width,c.height);work=c}}return work.toDataURL('image/jpeg',.15)}
$('makeJpg').onclick=async()=>{const files=[...$('pdfInput').files];if(!files.length)return alert('Please select a PDF file!');const btn=$('makeJpg');btn.disabled=true;$('pdfResult').innerHTML='';try{const docs=[];let total=0;for(const f of files){const doc=await getPdfForFile(f);docs.push(doc);total+=doc.numPages}let done=0,canvases=[],height=0,width=0;for(const doc of docs)for(let n=1;n<=doc.numPages;n++){const page=await doc.getPage(n),vp=page.getViewport({scale:2.5}),c=document.createElement('canvas'),ctx=c.getContext('2d');c.width=vp.width;c.height=vp.height;await page.render({canvasContext:ctx,viewport:vp}).promise;canvases.push(c);height+=c.height;width=Math.max(width,c.width);done++;const p=Math.min(88,8+Math.round(done/total*80));setProgress('pdf',p,`PDF page ${done} / ${total} is processing...`);await new Promise(requestAnimationFrame)}setProgress('pdf',94,'Merging all pages into JPG...');const out=document.createElement('canvas');out.width=width;out.height=height;const ctx=out.getContext('2d');ctx.fillStyle='#fff';ctx.fillRect(0,0,width,height);let y=0;canvases.forEach(c=>{ctx.drawImage(c,0,y);y+=c.height});const target=300;let url=await canvasToTargetJpeg(out,target);finishProgress('pdf');$('pdfResult').innerHTML=`<div class="result"><p><i class="fa-solid fa-circle-check"></i> All PDF pages merged into 1 Single JPG!</p>${sizePicker('pdfSize',target)}<a class="download" id="pdfDownload" href="${url}" download="RK_Output.jpg"><button class="btn"><i class="fa-solid fa-download"></i> Download Full JPG</button></a></div>`;$('pdfSize').value=String(target);$('pdfSize').onchange=async e=>{const sel=e.target,sz=Number(sel.value),b=$('pdfDownload').querySelector('button');sel.disabled=true;b.disabled=true;b.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Optimizing...';try{const nu=await canvasToTargetJpeg(out,sz);$('pdfDownload').href=nu;url=nu}catch(err){alert('Size optimization error: '+err.message)}finally{sel.disabled=false;b.disabled=false;b.innerHTML='<i class="fa-solid fa-download"></i> Download Full JPG'}}}catch(e){console.error(e);alert('Error generating JPG: '+e.message);$('pdfProgress').style.display='none'}finally{btn.disabled=false}};
</script>
