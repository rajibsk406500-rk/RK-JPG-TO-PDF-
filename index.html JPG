        <input id="rkPdfPassInput" type="password" autocomplete="off" placeholder="Enter PDF password">
        <span class="rk-pdf-eye" id="rkPdfPassEye" onclick="toggleRkPdfPassword()"><i class="rk-pro-icon fa-solid fa-eye" aria-hidden="true"></i></span>
      </div>
      <div class="rk-pdf-pass-error" id="rkPdfPassError">Incorrect password. Please try again.</div>
      <div class="rk-pdf-pass-actions">
        <button type="button" class="rk-pdf-pass-cancel" id="rkPdfPassCancel">Cancel</button>
        <button type="button" class="rk-pdf-pass-unlock" id="rkPdfPassUnlock"><i class="rk-pro-icon fa-solid fa-lock-open" aria-hidden="true"></i> Unlock PDF</button>
      </div>
    </div>
