<section id="pdfToJpg" class="section">
<div class="group"><label>1. <i class="fa-solid fa-folder-open"></i> Select PDF files (one or more):</label><input id="pdfInput" type="file" accept="application/pdf" multiple hidden><div class="upload" id="pdfBox"><i class="fa-solid fa-cloud-arrow-up" style="font-size:28px;color:#dc2626"></i><span class="upload-title" id="pdfText">Select PDF Files</span></div></div>
