  <div id="rkPdfPasswordModal" aria-hidden="true">
    <div class="rk-pdf-pass-card" role="dialog" aria-modal="true" aria-labelledby="rkPdfPassTitle">
      <div class="rk-pdf-pass-icon" aria-hidden="true">
        <svg class="rk-password-face" viewBox="0 0 700 700" role="img" aria-label="Password reaction">
          <defs>
            <radialGradient id="rkFaceYellowGradient" cx="42%" cy="25%" r="78%">
              <stop offset="0%" stop-color="#fff9b8"/>
              <stop offset="24%" stop-color="#ffe96a"/>
              <stop offset="70%" stop-color="#ffc21b"/>
              <stop offset="100%" stop-color="#f59a00"/>
            </radialGradient>
            <radialGradient id="rkFaceRedGradient" cx="40%" cy="22%" r="80%">
              <stop offset="0%" stop-color="#ff8b73"/>
              <stop offset="28%" stop-color="#ff4b3e"/>
              <stop offset="68%" stop-color="#f01818"/>
              <stop offset="100%" stop-color="#a40000"/>
            </radialGradient>
          </defs>

          <!-- Normal face: exactly one yellow head -->
          <g class="rk-face-yellow">
            <circle cx="350" cy="350" r="315" fill="url(#rkFaceYellowGradient)" stroke="#e66f00" stroke-width="9"/>
            <circle cx="350" cy="350" r="301" fill="none" stroke="#ffd84a" stroke-width="6" opacity=".65"/>
          </g>
          <g class="rk-face-happy-features" fill="#713000" stroke="#5a2500" stroke-width="4" stroke-linejoin="round">
            <!-- two happy eyes -->
            <ellipse cx="255" cy="345" rx="42" ry="55"/>
            <ellipse cx="445" cy="345" rx="42" ry="55"/>
            <!-- friendly smile -->
            <path d="M267 470 C315 532 385 532 433 470
                     C441 459 455 469 448 482
                     C397 570 303 570 252 482
                     C245 469 259 459 267 470 Z"/>
          </g>
          <g class="rk-face-happy-features" fill="#fff" opacity=".62">
            <ellipse cx="242" cy="326" rx="12" ry="18"/>
            <ellipse cx="432" cy="326" rx="12" ry="18"/>
          </g>

          <!-- Wrong-password face: one complete red head, no extra face underneath -->
          <g class="rk-face-red">
            <circle cx="350" cy="350" r="315" fill="url(#rkFaceRedGradient)" stroke="#9f0000" stroke-width="10"/>
            <circle cx="350" cy="350" r="301" fill="none" stroke="#ff6b5d" stroke-width="6" opacity=".55"/>
          </g>
          <!-- ANGRY FEATURES: one pair of brows, one pair of eyes, one angry mouth.
               The brow geometry itself slopes inward/downward; it is NOT rotated by CSS. -->
          <g class="rk-face-angry-features" fill="#330000" stroke="#1b0000" stroke-width="5" stroke-linejoin="round">
            <!-- LEFT eyebrow: outer end high, inner end low -->
            <path class="rk-face-angry-brow-left"
                  d="M178 266 C220 244 274 249 326 292
                     C337 301 332 317 318 311
                     C271 291 229 289 188 307
                     C171 314 162 276 178 266 Z"/>
            <!-- RIGHT eyebrow: mirror image; outer end high, inner end low -->
            <path class="rk-face-angry-brow-right"
                  d="M522 266 C480 244 426 249 374 292
                     C363 301 368 317 382 311
                     C429 291 471 289 512 307
                     C529 314 538 276 522 266 Z"/>

            <!-- TWO LARGE ANGRY EYES -->
            <ellipse cx="255" cy="365" rx="47" ry="61"/>
            <ellipse cx="445" cy="365" rx="47" ry="61"/>
          </g>

          <!-- Two eye highlights: keeps the expression alive instead of looking like a sad icon. -->
          <g class="rk-face-angry-features" fill="#ffffff">
            <ellipse cx="241" cy="346" rx="12" ry="17"/>
            <ellipse cx="431" cy="346" rx="12" ry="17"/>
            <circle cx="265" cy="383" r="5" opacity=".45"/>
            <circle cx="455" cy="383" r="5" opacity=".45"/>
          </g>

          <!-- ANGRY MOUTH: corners lower than the center, clearly a strong frown. -->
          <g class="rk-face-angry-features" fill="none" stroke="#330000" stroke-width="24" stroke-linecap="round">
            <path d="M270 515 Q350 450 430 515"/>
          </g>
        </svg>
