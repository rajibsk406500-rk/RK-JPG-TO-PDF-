    /* ===== PROFESSIONAL PDF PASSWORD UNLOCK DIALOG ===== */
    #rkPdfPasswordModal {
      display:none; position:fixed; inset:0; z-index:999999;
      align-items:center; justify-content:center; padding:18px;
      background:rgba(15,23,42,.62); backdrop-filter:blur(4px);
    }
    #rkPdfPasswordModal.show { display:flex; }
    #rkPdfPasswordModal .rk-pdf-pass-card {
      width:min(430px,100%); background:#fff; color:#172033;
      border:1px solid #e5e7eb; border-radius:16px; padding:20px;
      box-shadow:0 20px 60px rgba(0,0,0,.28);
    }
    /* ===== CODED SVG PASSWORD REACTION FACE ===== */
    #rkPdfPasswordModal .rk-pdf-pass-icon {
      width:104px; height:104px; margin:0 auto 10px;
      display:flex; align-items:center; justify-content:center;
      background:transparent; color:inherit; font-size:22px;
      position:relative;
    }
    #rkPdfPasswordModal .rk-password-face {
      width:104px; height:104px; display:block; overflow:visible;
      filter:drop-shadow(0 9px 8px rgba(0,0,0,.22));
      transform-origin:50% 50%;
      will-change:transform;
    }

    /* Only ONE complete face is visible at a time.
       Yellow = normal/happy. Red = wrong-password/angry. */
    #rkPdfPasswordModal .rk-face-yellow,
    #rkPdfPasswordModal .rk-face-red,
    #rkPdfPasswordModal .rk-face-happy-features,
    #rkPdfPasswordModal .rk-face-angry-features {
      transition:opacity .22s ease;
    }
    #rkPdfPasswordModal .rk-face-red,
    #rkPdfPasswordModal .rk-face-angry-features {
      opacity:0;
      pointer-events:none;
    }
    #rkPdfPasswordModal.rk-password-incorrect .rk-face-yellow,
    #rkPdfPasswordModal.rk-password-incorrect .rk-face-happy-features {
      opacity:0;
    }
    #rkPdfPasswordModal.rk-password-incorrect .rk-face-red,
    #rkPdfPasswordModal.rk-password-incorrect .rk-face-angry-features {
      opacity:1;
    }

    /* Happy: gentle floating/breathing animation. */
    #rkPdfPasswordModal:not(.rk-password-incorrect) .rk-password-face {
      animation:rkHappyBounce 2.2s ease-in-out infinite;
    }

    /* Wrong password: keep shaking repeatedly until the user starts typing again. */
    #rkPdfPasswordModal.rk-password-incorrect .rk-password-face {
      animation:rkAngryShake .78s cubic-bezier(.36,.07,.19,.97) infinite;
    }

    @keyframes rkHappyBounce {
      0%,100% { transform:translateY(0) rotate(0deg) scale(1); }
      25% { transform:translateY(-2px) rotate(-1deg) scale(1.015); }
      50% { transform:translateY(-4px) rotate(0deg) scale(1.025); }
      75% { transform:translateY(-2px) rotate(1deg) scale(1.015); }
    }

    @keyframes rkAngryShake {
      0%,100% { transform:translateX(0) rotate(0deg) scale(1); }
      8% { transform:translateX(-8px) rotate(-4deg) scale(1.02); }
      16% { transform:translateX(9px) rotate(4deg) scale(1.02); }
      24% { transform:translateX(-11px) rotate(-5deg) scale(1.025); }
      32% { transform:translateX(11px) rotate(5deg) scale(1.025); }
      40% { transform:translateX(-10px) rotate(-4deg) scale(1.02); }
      48% { transform:translateX(10px) rotate(4deg) scale(1.02); }
      56% { transform:translateX(-9px) rotate(-4deg) scale(1.018); }
      64% { transform:translateX(8px) rotate(3.5deg) scale(1.015); }
      72% { transform:translateX(-6px) rotate(-2.5deg) scale(1.01); }
      82% { transform:translateX(4px) rotate(2deg) scale(1.006); }
      92% { transform:translateX(-2px) rotate(-1deg) scale(1.002); }
    }

    /* Strong angry expression: eyebrows slope DOWN toward the center.
       No CSS rotation is applied to the brows, so they cannot flip into a sad look. */
    #rkPdfPasswordModal .rk-face-angry-features {
      transform-box:fill-box;
      transform-origin:center;
    }
    #rkPdfPasswordModal .rk-face-angry-brow-left,
    #rkPdfPasswordModal .rk-face-angry-brow-right {
      transform:none;
    }

    /* Red face gets a short entrance flash; the head itself keeps shaking. */
    #rkPdfPasswordModal.rk-password-incorrect .rk-face-red {
      animation:rkAngryFlash .32s ease-out 1;
    }
    @keyframes rkAngryFlash {
      0% { opacity:0; transform:scale(.94); }
      55% { opacity:1; transform:scale(1.04); }
      100% { opacity:1; transform:scale(1); }
    }

    /* When typing starts again, the single yellow face returns with a cheerful entrance. */
    #rkPdfPasswordModal.rk-password-reset .rk-password-face {
      animation:rkHappyReturn .62s cubic-bezier(.2,.8,.2,1) 1;
    }
    @keyframes rkHappyReturn {
      0% { transform:translateY(8px) scale(.84) rotate(-4deg); opacity:.35; }
      55% { transform:translateY(-5px) scale(1.06) rotate(2deg); opacity:1; }
      100% { transform:translateY(0) scale(1) rotate(0deg); opacity:1; }
    }

#rkPdfPasswordModal h3 { margin:0 0 7px; text-align:center; font-size:19px; }
    #rkPdfPasswordModal p { margin:0 0 14px; text-align:center; color:#64748b; font-size:13px; line-height:1.5; }
    #rkPdfPasswordModal .rk-pdf-pass-name {
